generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


// ================================
// IMAGE
// ================================

model Image {
  id          Int      @id @default(autoincrement())
  filename    String   @unique
  subject     String
  category    String
  caption     String
  confidence  Float
  status      String

  attributes  ImageAttribute[]
  embedding   ImageEmbedding?
  suggestions Suggestion[]
  reviews     Review[]

  createdAt   DateTime @default(now())

  @@index([category])
  @@index([subject])
}


// ================================
// IMAGE ATTRIBUTES / TAGS
// ================================

model ImageAttribute {
  id       Int    @id @default(autoincrement())
  value    String

  imageId  Int
  image    Image  @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@index([value])
  @@index([imageId])
}


// ================================
// IMAGE EMBEDDING
// ================================

model ImageEmbedding {
  id        Int    @id @default(autoincrement())
  vector    String

  imageId   Int    @unique
  image    Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)
}


// ================================
// BLOG POST
// ================================

model Post {
  id          Int          @id @default(autoincrement())
  title       String
  content     String

  embedding   PostEmbedding?
  suggestions Suggestion[]

  createdAt   DateTime     @default(now())

  @@index([title])
}


// ================================
// POST EMBEDDING
// ================================

model PostEmbedding {
  id       Int    @id @default(autoincrement())
  vector   String

  postId   Int    @unique
  post     Post   @relation(fields: [postId], references: [id], onDelete: Cascade)
}


// ================================
// IMAGE SUGGESTION
// ================================

model Suggestion {
  id          Int      @id @default(autoincrement())

  score       Float
  status      String   @default("pending")
  reason      String?

  postId      Int
  post        Post     @relation(fields: [postId], references: [id], onDelete: Cascade)

  imageId     Int
  image       Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([postId])
  @@index([imageId])
  @@index([score])
}


// ================================
// HUMAN REVIEW
// ================================

model Review {
  id          Int      @id @default(autoincrement())

  decision    String
  reason      String?

  imageId     Int
  image       Image    @relation(fields: [imageId], references: [id], onDelete: Cascade)

  createdAt   DateTime @default(now())

  @@index([imageId])
  @@index([decision])
}
// ================================
// BACKGROUND PROCESSING JOB
// ================================

model ProcessingJob {
  id          Int      @id @default(autoincrement())

  jobType     String
  status      String   @default("pending")

  totalItems  Int      @default(0)
  completed   Int      @default(0)
  failed      Int      @default(0)
  retries     Int      @default(0)

  startedAt   DateTime?
  completedAt DateTime?

  createdAt   DateTime @default(now())

  apiUsage    ApiUsage[]

  @@index([jobType])
  @@index([status])
}


// ================================
// API USAGE / COST TRACKING
// ================================

model ApiUsage {
  id          Int      @id @default(autoincrement())

  service     String
  model       String
  operation   String

  estimatedCostUsd Float @default(0)

  jobId       Int?
  job        ProcessingJob? @relation(fields: [jobId], references: [id], onDelete: SetNull)

  createdAt   DateTime @default(now())

  @@index([jobId])
  @@index([operation])
  @@index([createdAt])
}